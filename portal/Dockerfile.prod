# Production image for the student portal (Next.js standalone — fits Render 512 MB).
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json ./web/
COPY admin/package.json ./admin/
COPY portal/package.json ./portal/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=2048
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY fonts ./fonts
COPY portal ./portal
COPY web/package.json ./web/
COPY admin/package.json ./admin/

ARG API_URL=http://caisbe-api:10000
ARG NEXT_PUBLIC_SITE_URL=https://caisbe.org
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.caisbe.org
ARG NEXT_PUBLIC_PORTAL_URL=https://portal.caisbe.org
ENV API_URL=$API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL \
    NEXT_PUBLIC_PORTAL_URL=$NEXT_PUBLIC_PORTAL_URL

RUN npm run build -w portal

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=384 \
    API_URL=http://caisbe-api:10000

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/portal/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/portal/.next/static ./portal/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/portal/public ./portal/public

USER nextjs
EXPOSE 3000
CMD ["sh", "-c", "node portal/server.js"]
