API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@caisbe.org
ADMIN_PASSWORD=adminpass123
ADMIN_FULL_NAME=CAISBE Admin
DATABASE_URL=postgresql+psycopg://caisbe:caisbe@127.0.0.1:5433/caisbe
PORTAL_PUBLIC_URL=http://localhost:3002
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Create coupons / promotion codes in the Stripe Dashboard; Checkout allows students to enter them.
APP_ENV=development

# Email via Resend (newsletters + all transactional mail).
# Leave RESEND_API_KEY empty in dev to log emails instead of sending.
# Verify caisbe.org in Resend, then create an API key. Each From address must be on that domain.
RESEND_API_KEY=
EMAIL_FROM=CAISBE <noreply@caisbe.org>
EMAIL_FROM_NEWSLETTER=CAISBE Newsletter <newsletter@caisbe.org>
EMAIL_FROM_CONTACT=CAISBE <contact@caisbe.org>
EMAIL_FROM_INFO=CAISBE <info@caisbe.org>
EMAIL_FROM_SYSTEM=CAISBE <noreply@caisbe.org>

# Automatic job board sync (curated FM feed + optional Adzuna / Arbeitnow).
JOB_SYNC_ENABLED=true
JOB_SYNC_ON_STARTUP=true
JOB_SYNC_INTERVAL_HOURS=12
JOB_SYNC_EXPIRY_DAYS=45
# Optional JSON feed URL ({"jobs":[...]} or a bare array).
JOB_FEED_URL=
# Optional Adzuna API keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca

# Local / Render disk (used when S3_* below is not fully configured)
UPLOAD_DIR=./uploads

# Cloudflare R2 / S3-compatible object storage (optional).
# When all five are set, new uploads go to the bucket instead of UPLOAD_DIR.
# R2: create a bucket, enable a public r2.dev URL, create an API token with Object Read & Write.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=caisbe-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://pub-<id>.r2.dev
# S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_REGION=auto

# Production / Render notes:
# - Render injects DATABASE_URL as postgres://… — the API normalizes it to postgresql+psycopg://
# - Set APP_ENV=production and a strong JWT_SECRET
# - Mount a persistent disk at UPLOAD_DIR (default /var/data/uploads in Dockerfile.prod) as fallback
# - Prefer S3_* / R2 for durable media; see render.yaml
# - See render.yaml at the repo root for the full Blueprint
