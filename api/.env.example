API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@caisbe.org
ADMIN_PASSWORD=adminpass123
ADMIN_FULL_NAME=CAISBE Admin
DATABASE_URL=postgresql+psycopg://caisbe:caisbe@127.0.0.1:5433/caisbe
PORTAL_PUBLIC_URL=http://localhost:3002
APP_ENV=development

# Email (newsletter). Leave SMTP_HOST empty in dev to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=newsletter@caisbe.org
SMTP_USE_TLS=true

# Production / Render notes:
# - Render injects DATABASE_URL as postgres://… — the API normalizes it to postgresql+psycopg://
# - Set APP_ENV=production and a strong JWT_SECRET
# - Mount a persistent disk at UPLOAD_DIR (default /var/data/uploads in Dockerfile.prod)
# - See render.yaml at the repo root for the full Blueprint
